# Discord bot token from the Discord Developer Portal
DISCORD_TOKEN=your-bot-token-here

# Comma-separated list of Discord user IDs allowed to use owner-only commands
OWNER_IDS=123456789012345678

# Path to the SQLite database file.
# Locally this can stay as ./data/pakstats.db
# On Railway, point this at your mounted Volume, e.g. /data/pakstats.db
DB_PATH=./data/pakstats.db

# Rating formula weights: rating = wins * RATING_WIN_WEIGHT + tw * RATING_TW_WEIGHT
RATING_WIN_WEIGHT=2
RATING_TW_WEIGHT=1
