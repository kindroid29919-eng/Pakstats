# Discord bot token from the Discord Developer Portal
DISCORD_BOT_TOKEN=your-bot-token-here

# Comma-separated Discord user IDs allowed to use .addwins and .addtw
OWNER_IDS=123456789012345678

# Only needed for the terminal tools (npm run ban)
GUILD_ID=

# SQLite database file. Holds EVERYTHING: wins/TW, the .result counter, and
# the VS/Nick/EA role settings.
#
# IMPORTANT: this must be on persistent storage or it is wiped on every deploy.
#   Railway: add a Volume mounted at /data, then use:
#   DB_PATH=/data/team-pakistan.sqlite
# Locally the default below is fine.
DB_PATH=./data/team-pakistan.sqlite

# Rating = wins * RATING_WIN_WEIGHT + tw * RATING_TW_WEIGHT
RATING_WIN_WEIGHT=2
RATING_TW_WEIGHT=1
